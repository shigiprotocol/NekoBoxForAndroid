 }
+
+// STRIDER: REALITY servers on Xray-core v26.9.8+ reject a ClientHello that
+// has no X25519MLKEM768 key share (it was removed here before), while REALITY
+// servers older than ML-KEM support (early 2025) fail when it is sent.
+// The new hello (same as Xray / v2rayNG) is used first; per server, the old
+// one is tried only after the new one keeps failing, and is left as soon as
+// the server rejects it. Once a hello has worked for a server, network errors
+// never make it switch.
+type realityModeState struct {
+	classic   bool
+	hybridOK  bool
+	classicOK bool
+	fails     int
+}
+
+var (
+	realityModesAccess sync.Mutex
+	realityModes       = make(map[string]*realityModeState)
+)
+
+// realityModeFor returns true when the old hello (no X25519MLKEM768) must be used.
+func realityModeFor(key string) bool {
+	realityModesAccess.Lock()
+	defer realityModesAccess.Unlock()
+	st := realityModes[key]
+	return st != nil && st.classic
+}
+
+func realityModeResult(key string, classic bool, ok bool, rejected bool) {
+	realityModesAccess.Lock()
+	defer realityModesAccess.Unlock()
+	st := realityModes[key]
+	if st == nil {
+		if ok {
+			return // new hello works: nothing to remember
+		}
+		if len(realityModes) > 4096 {
+			realityModes = make(map[string]*realityModeState)
+		}
+		st = &realityModeState{}
+		realityModes[key] = st
+	}
+	if st.classic != classic {
+		return // result of a connection started before the last switch
+	}
+	if ok {
+		if classic {
+			st.classicOK = true
+		} else {
+			st.hybridOK = true
+		}
+		st.fails = 0
+		return
+	}
+	confirmed := (classic && st.classicOK) || (!classic && st.hybridOK)
+	if confirmed && !rejected {
+		return // a network error on a hello that works for this server
+	}
+	st.fails++
+	// the old hello rejected (server needs ML-KEM): switch back at once
+	if (classic && rejected) || st.fails >= 2 {
+		st.classic = !st.classic
+		st.fails = 0
+	}
+}
